<Window x:Class="CarDealer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Car Dealership"
        Width="1300" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#F2F2F5">

	<Window.Resources>

		<Style TargetType="TextBox">
			<Setter Property="Margin" Value="0,6"/>
			<Setter Property="Padding" Value="8"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="BorderBrush" Value="#D0D0D5"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Height" Value="34"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
							<ScrollViewer x:Name="PART_ContentHost"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style TargetType="Button">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="Height" Value="44"/>
			<Setter Property="Margin" Value="0,12,0,0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border CornerRadius="8"
                                Background="#3A7AFE">
							<ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
						</Border>

						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Opacity" Value="0.9"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter Property="Opacity" Value="0.75"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="Card" TargetType="Border">
			<Setter Property="CornerRadius" Value="14"/>
			<Setter Property="Padding" Value="20"/>
			<Setter Property="Margin" Value="15"/>
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect Color="#88000000"
                                      BlurRadius="16"
                                      ShadowDepth="3"/>
				</Setter.Value>
			</Setter>
		</Style>

	</Window.Resources>

	<Grid Margin="20">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="3*"/>
			<ColumnDefinition Width="2*"/>
		</Grid.ColumnDefinitions>

		<Border Style="{StaticResource Card}" Grid.Column="0">
			<DataGrid x:Name="CarGrid"
                      AutoGenerateColumns="True"
                      ItemsSource="{Binding Cars}"
                      SelectedItem="{Binding SelectedCar}"
                      Background="#FFFFFF"
                      BorderThickness="0"
                      Margin="5"
                      RowHeight="35"
                      FontSize="14"
                      HeadersVisibility="Column"
                      AlternatingRowBackground="#F4F4F4"
                      />
		</Border>

		<Border Style="{StaticResource Card}" Grid.Column="1">
			<StackPanel>

				<TextBlock Text="Add a New Car"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#1E1E1E"
                           Margin="0,0,0,20"/>

				<TextBlock Text="Manufacturer" Foreground="#2A2A2A"/>
				<TextBox x:Name="TxtManufacturer"/>

				<TextBlock Text="Model" Foreground="#2A2A2A"/>
				<TextBox x:Name="TxtModel"/>

				<TextBlock Text="Year" Foreground="#2A2A2A"/>
				<TextBox x:Name="TxtYear"/>

				<TextBlock Text="Displacement (L)" Foreground="#2A2A2A"/>
				<TextBox x:Name="TxtDispl"/>

				<TextBlock Text="Cylinders" Foreground="#2A2A2A"/>
				<TextBox x:Name="TxtCyl"/>

				<TextBlock Text="Transmission" Foreground="#2A2A2A"/>
				<TextBox x:Name="TxtTrans"/>

				<TextBlock Text="Drive Type" Foreground="#2A2A2A"/>
				<TextBox x:Name="TxtDrv"/>

				<TextBlock Text="City MPG" Foreground="#2A2A2A"/>
				<TextBox x:Name="TxtCty"/>

				<TextBlock Text="Highway MPG" Foreground="#2A2A2A"/>
				<TextBox x:Name="TxtHwy"/>

				<TextBlock Text="Fuel Type" Foreground="#2A2A2A"/>
				<TextBox x:Name="TxtFl"/>

				<TextBlock Text="Class" Foreground="#2A2A2A"/>
				<TextBox x:Name="TxtClass"/>

				<Button Content="Add Car" Click="AddCar_Click"/>
				<Button Content="Delete Selected Car"
                        Background="#E04646"
                        Click="DeleteCar_Click"/>
				<Button Content="Save All Changes"
                        Background="#2EB85C"
                        Click="SaveChanges_Click"/>
			</StackPanel>
		</Border>

	</Grid>
</Window>
