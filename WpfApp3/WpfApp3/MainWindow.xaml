<Window x:Class="CarDealer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Car Dealership" Width="1200" Height="600">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- Car List -->
        <DataGrid x:Name="CarGrid"
                  Grid.Column="0"
                  AutoGenerateColumns="True"
                  ItemsSource="{Binding Cars}"
                  SelectedItem="{Binding SelectedCar}"
                  Margin="5" />

        <!-- Controls -->
        <StackPanel Grid.Column="1" Margin="20">
            <TextBlock Text="Add a New Car" FontSize="20" Margin="0,0,0,20"/>

            <TextBlock Text="Manufacturer"/>
            <TextBox x:Name="TxtManufacturer" Margin="0,5"/>

            <TextBlock Text="Model"/>
            <TextBox x:Name="TxtModel" Margin="0,5"/>

            <TextBlock Text="Year"/>
            <TextBox x:Name="TxtYear" Margin="0,5"/>

            <TextBlock Text="Displacement (L)"/>
            <TextBox x:Name="TxtDispl" Margin="0,5"/>

            <TextBlock Text="Cylinders"/>
            <TextBox x:Name="TxtCyl" Margin="0,5"/>

            <TextBlock Text="Transmission"/>
            <TextBox x:Name="TxtTrans" Margin="0,5"/>

            <TextBlock Text="Drive Type"/>
            <TextBox x:Name="TxtDrv" Margin="0,5"/>

            <TextBlock Text="City MPG"/>
            <TextBox x:Name="TxtCty" Margin="0,5"/>

            <TextBlock Text="Highway MPG"/>
            <TextBox x:Name="TxtHwy" Margin="0,5"/>

            <TextBlock Text="Fuel Type"/>
            <TextBox x:Name="TxtFl" Margin="0,5"/>

            <TextBlock Text="Class"/>
            <TextBox x:Name="TxtClass" Margin="0,5"/>

            <Button Content="Add Car" Height="40" Margin="0,20,0,5"
                    Click="AddCar_Click"/>

            <Button Content="Delete Selected Car" Height="40" Margin="0,5"
                    Click="DeleteCar_Click"/>

            <Button Content="Save All Changes" Height="40" Margin="0,20,0,5"
                    Click="SaveChanges_Click"/>
        </StackPanel>

    </Grid>
</Window>