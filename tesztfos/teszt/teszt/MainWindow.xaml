<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="JsonReaderApp.MainWindow"
        Title="Car Information" Height="350" Width="525">
    <Grid>
        <ListBox x:Name="CarListBox" HorizontalAlignment="Left" Height="250" Margin="10,10,0,0" VerticalAlignment="Top" Width="480" >
          <ListBox Height="100" Width="100" d:ItemsSource="{d:SampleData ItemCount=5}"/>
     
        </ListBox>
    </Grid>
</Window>

